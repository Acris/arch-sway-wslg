{
  "layer": "top",
  "position": "top",
  // Waybar's own defaults for the bar height and the gap between modules.
  "height": 32,
  "spacing": 4,
  "fixed-center": false,
  "modules-left": [
    "sway/workspaces",
    "sway/mode",
    "sway/scratchpad"
  ],
  "modules-center": [
    "sway/window"
  ],
  "modules-right": [
    "group/resources",
    "pulseaudio",
    "tray",
    "custom/notification",
    "clock"
  ],
  // Only memory stays visible; CPU and disk slide out on hover so the right
  // side keeps five items instead of seven.
  "group/resources": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "children-class": "resource",
      "transition-left-to-right": false
    },
    "modules": [
      "memory",
      "cpu",
      "disk"
    ]
  },
  "memory": {
    "interval": 5,
    "format": "󰍛  {percentage}%",
    "states": {
      "warning": 80,
      "critical": 92
    },
    "tooltip": true,
    "tooltip-format": "RAM  {used:0.1f}G / {total:0.1f}G\nSwap {swapUsed:0.1f}G / {swapTotal:0.1f}G"
  },
  "cpu": {
    "interval": 5,
    "format": "󰻠  {usage}%",
    "states": {
      "warning": 80,
      "critical": 95
    },
    "tooltip": true,
    "tooltip-format": "CPU {usage}% over {load} load"
  },
  "disk": {
    "interval": 60,
    "path": "/",
    "format": "󰋊  {percentage_used}%",
    "states": {
      "warning": 85,
      "critical": 95
    },
    "tooltip": true,
    "tooltip-format": "{used} used of {total} on {path}"
  },
  "sway/workspaces": {
    "all-outputs": false,
    "disable-scroll": true,
    "disable-click": false,
    "disable-auto-back-and-forth": true,
    "format": "{name}"
  },
  "sway/mode": {
    "format": "󰩨  {}",
    "tooltip": false
  },
  "sway/scratchpad": {
    "format": "  {count}",
    "show-empty": false,
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },
  "sway/window": {
    "format": "{title}",
    "max-length": 40,
    "tooltip": false
  },
  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon}  {volume}%",
    "format-muted": "󰖁  muted",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip": true,
    "tooltip-format": "{desc}\nVolume: {volume}%"
  },
  "tray": {
    // 22 is one of the sizes the Papirus icon theme ships, so tray icons are
    // never rescaled.
    "icon-size": 22,
    "spacing": 10,
    "show-passive-items": false
  },
  "custom/notification": {
    "tooltip": true,
    // The glyph is sized from style.css like every other module.
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "clock": {
    "interval": 60,
    "format": "󰥔  {:%H:%M}",
    "format-alt": "󰃭  {:%Y-%m-%d  %a}",
    "tooltip": true,
    "tooltip-format": "<big><b>{:%Y %B}</b></big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#cba6f7'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'>{}</span>",
        "weeks": "<span color='#6c7086'>W{}</span>",
        "weekdays": "<span color='#89b4fa'><b>{}</b></span>",
        "today": "<span color='#11111b' background='#cba6f7'><b>{}</b></span>"
      }
    }
  }
}
