#!/usr/bin/env bash
# Bidirectional UTF-8 plain-text clipboard bridge for the managed Sway session.
#
# WSLg already synchronises its own Wayland clipboard with Windows in both
# directions, so the nested compositor only has to mirror text against the
# parent WSLg Wayland socket. Sway starts this bridge with `exec`, which means
# it inherits the nested WAYLAND_DISPLAY and lives inside the session scope.
#
# The two sides are not symmetric. Sway implements wlr-data-control, so the
# nested selection can be watched through events. WSLg's Weston implements no
# data-control protocol at all, which makes `wl-paste --watch` exit immediately
# against the parent. The parent side is therefore polled with one-shot reads,
# which is also why the direction and the interval are configurable.
#
# Neither direction can touch the parent without taking focus there for a
# moment, and wlroots replays the keys that were held when focus returns. Reads
# therefore wait for the session to report no input activity, and writes allow
# a short settling period for the copy shortcut to be released. The bridge
# starts swayidle itself and supervises it, so the gate cannot silently outlast
# the bridge.
set -Eeuo pipefail
umask 077

NAME="arch-sway-wslg"
SELF="$(readlink -f "$0")"
PARENT_DISPLAY="/mnt/wslg/runtime-dir/wayland-0"
NESTED_DISPLAY="${WAYLAND_DISPLAY:-}"
RUNTIME_BASE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
STATE_DIR="$RUNTIME_BASE/$NAME/clipboard"
BRIDGE_LOCK="$STATE_DIR/bridge.lock"
EVENT_LOCK="$STATE_DIR/event.lock"
MIRROR_FILE="$STATE_DIR/mirror"
PARENT_SEEN_FILE="$STATE_DIR/parent-seen"
PID_FILE="$STATE_DIR/bridge.pid"
STATUS_FILE="$STATE_DIR/status"
COPY_TYPE="text/plain;charset=utf-8"
EVENT_LOCK_TIMEOUT=5
COPY_TIMEOUT="3s"
MAX_RESTARTS=5
RESTART_RESET_AFTER=60

# both:       mirror in both directions (default)
# to-windows: only forward the nested selection outwards; never poll the parent
# off:        do not bridge at all
MODE="${ARCH_SWAY_WSLG_CLIPBOARD:-both}"
# Reading the parent selection briefly opens a surface on the outer compositor,
# so the interval trades inbound latency against how often WSLg is disturbed.
# One second stays below what is noticeable between a copy on Windows and the
# switch back into the session; below the floor the reads start to overlap.
POLL_INTERVAL="${ARCH_SWAY_WSLG_CLIPBOARD_POLL:-1.0}"
POLL_INTERVAL_MIN_MS=200
POLL_INTERVAL_MS=0
PARENT_READ_TIMEOUT="3s"

# Text copied on Windows is normally pasted soon afterwards, so the reads matter
# most in the first moments of quiet. A session that has been quiet far longer
# is usually one nobody is copying into, and reading it that often only
# disturbs whatever has the focus on Windows. The interval therefore doubles
# once the quiet has lasted a while, and any input starts it over.
POLL_BACKOFF_AFTER_MS=30000
POLL_BACKOFF_MAX_FACTOR=8
QUIET_TICKS=0
POLL_FACTOR=1
POLL_PENDING=0

# A read on the parent takes keyboard focus away from the nested session, and
# wlroots replays the keys that were held when focus returns, so a poll that
# overlaps typing duplicates or drops characters. swayidle reports the two
# transitions as signals, which gate the polling on the session being quiet, and
# the quiet period is what actually decides the inbound latency.
IDLE_TIMEOUT="${ARCH_SWAY_WSLG_CLIPBOARD_IDLE:-2}"
# The copy shortcut may still be held when the bridge reacts to it, so a short
# settling period normally lets the keys go before focus moves to the parent.
FOCUS_SETTLE_DELAY="0.3"
IDLE=0
IDLE_PID=""
IDLE_RESTARTS=0
IDLE_STARTED_AT=0
GATED=1

WATCHER_PID=""
WATCHER_STARTED_AT=0

note() { printf '%s\n' "clipboard: $*"; }
warn() { printf 'WARNING: clipboard: %s\n' "$*" >&2; }
die() { printf 'ERROR: clipboard: %s\n' "$*" >&2; exit 1; }

set_status() {
    printf '%s\n' "$1" > "$STATUS_FILE"
}

# Fixed-point milliseconds keep the floor check inside Bash. The caller
# validates the number format first.
interval_ms() {
    local whole="${1%%.*}" frac="000"

    [[ "$1" == *.* ]] && frac="${1#*.}000"
    printf '%d' "$(( 10#$whole * 1000 + 10#${frac:0:3} ))"
}

# ---------------------------------------------------------------------------
# Selection mirroring
# ---------------------------------------------------------------------------
payload_hash() {
    local hash
    hash="$(sha256sum < "$1" 8>&- 9>&-)"
    printf '%s' "${hash%% *}"
}

# Both directions share one mirror hash, which holds the text that was forwarded
# last, so an echo is recognised no matter which side observes it next. Callers
# must hold the event lock: this is a read-modify-write and the selection has to
# be published before the peer can see it.
publish_selection() {
    local direction="$1" payload="$2" hash="$3"

    if [[ -r "$MIRROR_FILE" && "$(<"$MIRROR_FILE")" == "$hash" ]]; then
        return 0
    fi

    # The hash is recorded only once the peer really holds the text. A hash
    # written for a failed copy would mark that text as already mirrored and
    # suppress every later attempt at it. Echoes stay suppressed regardless:
    # the peer cannot report the new selection before this lock is released.
    copy_selection "$direction" < "$payload" || {
        warn "failed to publish text ($direction)"
        return 1
    }
    printf '%s' "$hash" > "$MIRROR_FILE"
}

copy_selection() {
    local display
    case "$1" in
        to-parent) display="$PARENT_DISPLAY" ;;
        to-sway)   display="$NESTED_DISPLAY" ;;
        *)         return 1 ;;
    esac
    WAYLAND_DISPLAY="$display" timeout "$COPY_TIMEOUT" \
        wl-copy --type "$COPY_TYPE" 8>&- 9>&-
}

# Entry point for the nested watcher; one instance runs per selection change.
mirror_selection() {
    local payload="$STATE_DIR/payload.$$" status=0

    case "${CLIPBOARD_STATE:-data}" in
        nil|clear) return 0 ;;
        sensitive)
            [[ "${ARCH_SWAY_WSLG_SYNC_SENSITIVE:-0}" == 1 ]] || return 0
            ;;
    esac

    [[ -d "$STATE_DIR" ]] || return 0

    # The text is read before the delay: the watcher hands it over through a
    # pipe and would block until it is drained. Bound a source that never
    # finishes, and keep callbacks from different watcher generations apart.
    if ! timeout "$COPY_TIMEOUT" cat > "$payload" 8>&- 9>&-; then
        rm -f -- "$payload"
        warn "failed or timed out reading the nested selection"
        return 1
    fi
    if [[ ! -s "$payload" ]]; then
        rm -f -- "$payload"
        return 0
    fi

    # Writing the parent selection also takes focus away. The nested watcher is
    # serial, so a short settling delay is all that is needed for the copy
    # shortcut to be released; there is no concurrent burst to coalesce here.
    sleep "$FOCUS_SETTLE_DELAY" 8>&- 9>&-

    # The lock is scoped to this call: the supervisor polls the parent side in
    # the same way, so a descriptor left open would deadlock the other side.
    mirror_locked "$payload" 9>"$EVENT_LOCK" || status=1
    rm -f -- "$payload"
    return "$status"
}

mirror_locked() {
    local payload="$1"

    flock -w "$EVENT_LOCK_TIMEOUT" 9 || {
        warn "timed out waiting for the bridge lock"
        return 1
    }

    publish_selection to-parent "$payload" "$(payload_hash "$payload")"
}

# A one-shot read is the only way to see the parent selection, and it has to
# happen under the lock, because a snapshot taken outside it can already be
# stale by the time it is compared.
poll_parent() {
    [[ -d "$STATE_DIR" ]] || return 0
    poll_parent_locked 9>"$EVENT_LOCK"
}

poll_parent_locked() {
    local snapshot="$STATE_DIR/parent.snapshot" hash

    flock -w "$EVENT_LOCK_TIMEOUT" 9 || {
        warn "timed out waiting for the bridge lock"
        return 0
    }

    # wl-paste fails when the parent offers no text at all, which is normal.
    # Without data-control the read depends on the parent compositor focusing a
    # temporary surface, so bound it: a stuck read would hold the event lock and
    # stall the outgoing direction as well.
    WAYLAND_DISPLAY="$PARENT_DISPLAY" timeout "$PARENT_READ_TIMEOUT" \
        wl-paste --no-newline --type text \
        > "$snapshot" 2>/dev/null 8>&- 9>&- || { rm -f -- "$snapshot"; return 0; }
    if [[ -s "$snapshot" ]]; then
        hash="$(payload_hash "$snapshot")"
        # Only an actual change on the parent side counts. wl-copy publishes the
        # outgoing selection asynchronously, so the value read right after a
        # forward is often still the previous one; treating it as new would push
        # it straight back into the nested session.
        if [[ ! -r "$PARENT_SEEN_FILE" || "$(<"$PARENT_SEEN_FILE")" != "$hash" ]]; then
            if publish_selection to-sway "$snapshot" "$hash"; then
                printf '%s' "$hash" > "$PARENT_SEEN_FILE"
            fi
        fi
    fi
    rm -f -- "$snapshot"
}

reset_poll_backoff() {
    QUIET_TICKS=0
    POLL_FACTOR=1
    POLL_PENDING=0
}

# Polling is skipped entirely while the user is typing, which is also when the
# inbound direction is least useful: text copied on Windows is picked up on the
# first poll after the session goes quiet again, and switching back into the
# session restores the configured interval. A gate that had to be given up stops
# the automatic reads rather than releasing them.
poll_parent_when_idle() {
    [[ "$MODE" == both ]] || return 0
    if ! (( GATED && IDLE )); then
        reset_poll_backoff
        return 0
    fi

    QUIET_TICKS=$((QUIET_TICKS + 1))
    if (( POLL_PENDING > 0 )); then
        POLL_PENDING=$((POLL_PENDING - 1))
        return 0
    fi

    poll_parent
    if (( QUIET_TICKS * POLL_INTERVAL_MS >= POLL_BACKOFF_AFTER_MS &&
          POLL_FACTOR < POLL_BACKOFF_MAX_FACTOR )); then
        POLL_FACTOR=$((POLL_FACTOR * 2))
    fi
    POLL_PENDING=$((POLL_FACTOR - 1))
}

# ---------------------------------------------------------------------------
# Idle gating
# ---------------------------------------------------------------------------
# swayidle is a child of the bridge, so it shares its lifetime, needs no PID
# file, and its failures are visible here instead of in the Sway configuration.
start_idle_notifier() {
    [[ "$MODE" == both ]] || return 0

    swayidle -w \
        timeout "$IDLE_TIMEOUT" "kill -USR1 $$" \
        resume "kill -USR2 $$" >/dev/null 2>&1 8>&- 9>&- &
    IDLE_PID=$!
    IDLE_STARTED_AT=$SECONDS
    IDLE=0
}

stop_idle_notifier() {
    [[ "$IDLE_PID" =~ ^[0-9]+$ ]] || return 0
    kill "$IDLE_PID" 2>/dev/null || true
    wait "$IDLE_PID" 2>/dev/null || true
    IDLE_PID=""
}

# Without the gate the inbound reads would type into whatever the user is
# writing, so a notifier that keeps dying disables that direction instead of
# being ignored. The launcher reports which of the two applies.
supervise_idle_notifier() {
    [[ "$MODE" == both ]] || return 0
    (( GATED )) || return 0
    [[ "$IDLE_PID" =~ ^[0-9]+$ ]] || return 0
    if kill -0 "$IDLE_PID" 2>/dev/null; then
        return 0
    fi

    wait "$IDLE_PID" 2>/dev/null || true
    IDLE_PID=""
    if (( SECONDS - IDLE_STARTED_AT >= RESTART_RESET_AFTER )); then
        IDLE_RESTARTS=0
    fi
    IDLE_RESTARTS=$((IDLE_RESTARTS + 1))
    if (( IDLE_RESTARTS > MAX_RESTARTS )); then
        GATED=0
        IDLE=0
        set_status degraded
        warn "swayidle kept exiting; the Windows clipboard is no longer read automatically"
        warn "restart the session to bring that direction back"
        return 0
    fi
    warn "swayidle exited; restarting ($IDLE_RESTARTS/$MAX_RESTARTS)"
    start_idle_notifier
}

# ---------------------------------------------------------------------------
# Supervisor
# ---------------------------------------------------------------------------
nested_display_alive() {
    local socket="$NESTED_DISPLAY"
    [[ "$socket" == /* ]] || socket="$RUNTIME_BASE/$socket"
    [[ -S "$socket" ]]
}

# Payload files belong to a single callback, which removes its own, so they are
# only swept when no callback of this bridge can still be waiting: at startup
# and on the way out.
clear_state() {
    rm -f -- "$STATE_DIR/parent.snapshot" "$STATE_DIR"/payload.* \
        "$MIRROR_FILE" "$PARENT_SEEN_FILE" "$PID_FILE" "$STATUS_FILE"
}

start_watcher() {
    # Only the parent snapshot is dropped here. What has already been mirrored
    # is kept, because a restarted watcher reports the current nested selection
    # straight away and would otherwise push it back over whatever Windows holds
    # by then; a payload belongs to a callback that may still be running.
    rm -f -- "$STATE_DIR/parent.snapshot"

    # The first supervisor poll mirrors whatever is already on the Windows
    # clipboard, so a fresh session inherits it as soon as it goes idle.
    wl-paste --type text --watch "$SELF" __mirror 8>&- 9>&- &
    WATCHER_PID=$!
    WATCHER_STARTED_AT=$SECONDS
}

stop_watcher() {
    [[ "$WATCHER_PID" =~ ^[0-9]+$ ]] || return 0
    kill "$WATCHER_PID" 2>/dev/null || true
    wait "$WATCHER_PID" 2>/dev/null || true
    WATCHER_PID=""
}

cleanup() {
    trap - EXIT INT TERM HUP
    stop_watcher
    stop_idle_notifier
    clear_state
}

run_bridge() {
    command -v wl-copy >/dev/null 2>&1 || die "wl-copy is required"
    command -v wl-paste >/dev/null 2>&1 || die "wl-paste is required"
    [[ -n "${WAYLAND_DISPLAY:-}" ]] || die "this bridge must be started from inside Sway"
    case "$MODE" in
        both|to-windows|off) ;;
        *) die "invalid ARCH_SWAY_WSLG_CLIPBOARD value: $MODE" ;;
    esac
    [[ "$POLL_INTERVAL" =~ ^[0-9]+([.][0-9]+)?$ ]] || \
        die "invalid ARCH_SWAY_WSLG_CLIPBOARD_POLL value: $POLL_INTERVAL"
    POLL_INTERVAL_MS="$(interval_ms "$POLL_INTERVAL")"
    (( POLL_INTERVAL_MS >= POLL_INTERVAL_MIN_MS )) || \
        die "ARCH_SWAY_WSLG_CLIPBOARD_POLL must be at least ${POLL_INTERVAL_MIN_MS}ms: $POLL_INTERVAL"
    if [[ ! "$IDLE_TIMEOUT" =~ ^[0-9]+$ ]] || (( IDLE_TIMEOUT < 1 )); then
        die "ARCH_SWAY_WSLG_CLIPBOARD_IDLE must be a whole number of seconds, at least 1: $IDLE_TIMEOUT"
    fi
    mkdir -p "$STATE_DIR"
    chmod 700 "$STATE_DIR"

    exec 8>"$BRIDGE_LOCK"
    flock -n 8 || exit 0

    # Anything left by a bridge that was killed outright describes selections
    # this session never saw.
    clear_state
    if [[ "$MODE" == off ]]; then
        set_status off
        note "bridging disabled by ARCH_SWAY_WSLG_CLIPBOARD=off"
        return 0
    fi
    [[ -S "$PARENT_DISPLAY" ]] || die "WSLg Wayland socket not found: $PARENT_DISPLAY"

    printf '%s\n' "$$" > "$PID_FILE"
    set_status "$MODE"
    trap cleanup EXIT
    trap 'cleanup; exit 0' INT TERM HUP
    trap 'IDLE=1' USR1
    trap 'IDLE=0' USR2

    case "$MODE" in
        both)       note "mirroring text both ways; the parent side is read every ${POLL_INTERVAL}s after ${IDLE_TIMEOUT}s without input, less often the longer that lasts" ;;
        to-windows) note "forwarding text to Windows only" ;;
    esac

    start_idle_notifier

    local restarts=0
    while true; do
        start_watcher
        while kill -0 "$WATCHER_PID" 2>/dev/null; do
            sleep "$POLL_INTERVAL" 8>&- 9>&- || true
            [[ -S "$PARENT_DISPLAY" ]] || break
            supervise_idle_notifier
            poll_parent_when_idle
        done
        stop_watcher
        nested_display_alive || break
        [[ -S "$PARENT_DISPLAY" ]] || {
            warn "the WSLg Wayland socket disappeared; stopping"
            break
        }
        if (( SECONDS - WATCHER_STARTED_AT >= RESTART_RESET_AFTER )); then
            restarts=0
        fi
        restarts=$((restarts + 1))
        if (( restarts > MAX_RESTARTS )); then
            warn "the nested watcher kept exiting; giving up after $MAX_RESTARTS restarts"
            break
        fi
        warn "the nested watcher exited; restarting ($restarts/$MAX_RESTARTS)"
        sleep 1 8>&- 9>&-
    done
}

case "${1:-}" in
    '')       run_bridge ;;
    __mirror) mirror_selection ;;
    *)        die "unknown argument: $1" ;;
esac
