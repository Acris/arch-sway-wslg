#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

NAME="arch-sway-wslg"
# install.sh replaces this marker with the contents of VERSION.
VERSION="__ARCH_SWAY_WSLG_VERSION__"
SELF="$(readlink -f "$0")"
UID_NUM="$(id -u)"
USER_NAME="$(id -un)"
LOCAL_PREFIX="$(dirname -- "$(dirname -- "$SELF")")"
LIBEXEC_DIR="$LOCAL_PREFIX/libexec/$NAME"
CLIPBOARD_BROKER="$LIBEXEC_DIR/arch-sway-wslg-clipboard"
CLIPBOARD_AGENT="$LIBEXEC_DIR/arch-sway-wslg-clipboard-agent.exe"

if [[ "${XDG_CONFIG_HOME:-}" == /* ]]; then
    CONFIG_HOME="$XDG_CONFIG_HOME"
else
    CONFIG_HOME="$HOME/.config"
    unset XDG_CONFIG_HOME
fi
if [[ "${XDG_STATE_HOME:-}" == /* ]]; then
    STATE_BASE="$XDG_STATE_HOME"
else
    STATE_BASE="$HOME/.local/state"
    unset XDG_STATE_HOME
fi
STATE_DIR="$STATE_BASE/$NAME"

# The managed session requires systemd and always uses the login-scoped user
# runtime. Ignore WSLg's shared /mnt/wslg/runtime-dir value; the parent Wayland
# connection uses an absolute socket path below.
SYSTEMD_RUNTIME_DIR="/run/user/$UID_NUM"
# The session and every systemd call share the persistent user bus. Bind its
# address instead of trusting an inherited one: WSLg may export something else,
# and a stale value would send systemctl and the session to different buses.
USER_BUS_ADDRESS="unix:path=$SYSTEMD_RUNTIME_DIR/bus"
RUNTIME_DIR="$SYSTEMD_RUNTIME_DIR/$NAME"
SESSION_SCOPE="${NAME}-session.scope"
CLIPBOARD_SERVICE="${NAME}-clipboard.service"
NAMESPACE_LAUNCH_PID=""

LOG_FILE="$STATE_DIR/sway.log"
LOCK_FILE="$STATE_DIR/control.lock"
SWAYSOCK_PATH="$RUNTIME_DIR/sway-ipc.sock"
WSLG_SOCKET="/mnt/wslg/runtime-dir/wayland-0"
WSLG_PULSE="/mnt/wslg/PulseServer"
X11_SOCKET_DIR="/tmp/.X11-unix"
X11_PRIVATE_DIR="$RUNTIME_DIR/x11-unix"
CLIPBOARD_STATE_DIR="$RUNTIME_DIR/clipboard"
CLIPBOARD_STATUS_FILE="$CLIPBOARD_STATE_DIR/status"
SWAY_CONFIG="$CONFIG_HOME/sway/config"
BROWSER_FILE="$CONFIG_HOME/$NAME/browser"
START_TIMEOUT=8
STOP_TIMEOUT=5
CONTROL_LOCK_TIMEOUT=60
# WSL can recreate /run/user/$UID underneath a running distribution, which
# leaves the bus socket present but unanswered, so every call that talks to the
# bus is bounded. The limit covers stopping the session scope, the longest job
# the launcher ever waits for.
USER_BUS_TIMEOUT=$((STOP_TIMEOUT + 5))
OUTPUTS_MAX=4
SESSION_OUTPUTS="${ARCH_SWAY_WSLG_OUTPUTS:-1}"

# Everything the managed session cannot start without, minus what a minimal Arch
# install already provides through util-linux, coreutils and systemd. The
# The clipboard data plane is bundled, so only its systemd launcher belongs in
# the external command list.
SESSION_COMMANDS=(sway Xwayland swaymsg systemd-run sudo timeout)

# Started by the Sway configuration itself. A missing one only shows up in the
# session log, so `doctor` reports them instead.
SESSION_APPLICATIONS=(swaybg waybar swaync swaync-client foot fuzzel yazi swaynag)

# Used by the media keys only. No installed package provides them directly:
# they arrive with Waybar's own dependencies, so `doctor` mentions them without
# failing over a binding that does nothing.
SESSION_MEDIA_COMMANDS=(pactl playerctl)

note() { printf '%s\n' "$*"; }
warn() { printf 'WARNING: %s\n' "$*" >&2; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

need() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

# Activation details describe how a process was started, not which bus to use;
# dropping them keeps an inherited value from redirecting children. Callers
# treat the timeout like any other failure to reach the bus.
user_bus_command() {
    timeout "$USER_BUS_TIMEOUT" \
        env -u DBUS_STARTER_ADDRESS -u DBUS_STARTER_BUS_TYPE \
        XDG_RUNTIME_DIR="$SYSTEMD_RUNTIME_DIR" \
        DBUS_SESSION_BUS_ADDRESS="$USER_BUS_ADDRESS" "$@"
}

# `busctl list` reports acquired and activatable names together, and busctl
# comes from systemd, so the bus checks below add no dependency. One listing
# answers every question, so callers pass it in rather than querying again.
bus_name_state() {
    local names="$1" name="$2" line first second state=""

    while IFS= read -r line; do
        read -r first second _ <<<"$line"
        [[ "$first" == "$name" ]] || continue
        if [[ "$second" == "-" ]]; then
            [[ -n "$state" ]] || state="activatable"
        else
            state="owned"
        fi
    done <<<"$names"

    [[ -n "$state" ]] || return 1
    printf '%s\n' "$state"
}

systemctl_user() {
    user_bus_command systemctl --user "$@"
}

systemd_user_usable() {
    [[ -d /run/systemd/system && -d "$SYSTEMD_RUNTIME_DIR" && \
       -O "$SYSTEMD_RUNTIME_DIR" && -w "$SYSTEMD_RUNTIME_DIR" && \
       -S "$SYSTEMD_RUNTIME_DIR/bus" ]] || return 1
    systemctl_user show-environment >/dev/null 2>&1
}

session_scope_active() {
    systemctl_user is-active --quiet "$SESSION_SCOPE" >/dev/null 2>&1
}

session_requirements() {
    local command
    parse_clipboard_options
    for command in "${SESSION_COMMANDS[@]}"; do
        need "$command"
    done
    systemd_user_usable || \
        die "systemd user manager is unavailable; start this Arch WSL distribution with systemd"
}

ensure_dirs() {
    systemd_user_usable || \
        die "systemd user runtime is unavailable: $SYSTEMD_RUNTIME_DIR"
    mkdir -p "$STATE_DIR" "$RUNTIME_DIR"
    chmod 700 "$STATE_DIR" "$RUNTIME_DIR"
}

take_control_lock() {
    exec 9>"$LOCK_FILE"
    flock -w "$CONTROL_LOCK_TIMEOUT" 9 || \
        die "another $NAME command has held the control lock for more than ${CONTROL_LOCK_TIMEOUT}s"
}

ipc_ready() {
    [[ -S "$SWAYSOCK_PATH" ]] || return 1
    swaymsg -s "$SWAYSOCK_PATH" -t get_version >/dev/null 2>&1
}

check_wslg() {
    [[ -S "$WSLG_SOCKET" ]] || die "WSLg Wayland socket not found: $WSLG_SOCKET"
    [[ -d "$X11_SOCKET_DIR" ]] || \
        die "X11 socket directory not found: $X11_SOCKET_DIR"
}

parse_outputs() {
    local value="$1"
    if [[ ! "$value" =~ ^[0-9]+$ ]] || (( value < 1 || value > OUTPUTS_MAX )); then
        die "nested output count must be an integer from 1 through $OUTPUTS_MAX: $value"
    fi
    SESSION_OUTPUTS="$value"
}

# The environment variable reaches the same place as the option, including the
# inner session process, so it is validated wherever the value is used rather
# than only on the command-line path.
parse_session_options() {
    parse_outputs "$SESSION_OUTPUTS"
    while (( $# )); do
        case "$1" in
            --outputs)
                [[ -n "${2:-}" ]] || die "--outputs requires a value"
                parse_outputs "$2"
                shift 2
                ;;
            --outputs=*)
                parse_outputs "${1#*=}"
                shift
                ;;
            *) die "unknown option: $1" ;;
        esac
    done
}

# -----------------------------------------------------------------------------
# Clipboard service
# -----------------------------------------------------------------------------
clipboard_available() {
    [[ -x "$CLIPBOARD_BROKER" && -x "$CLIPBOARD_AGENT" ]]
}

clipboard_running() {
    systemctl_user is-active --quiet "$CLIPBOARD_SERVICE" >/dev/null 2>&1
}

clipboard_status_field() {
    local wanted="$1" key value
    [[ -r "$CLIPBOARD_STATUS_FILE" ]] || return 1
    while IFS='=' read -r key value; do
        [[ "$key" == "$wanted" ]] || continue
        printf '%s\n' "$value"
        return 0
    done < "$CLIPBOARD_STATUS_FILE"
    return 1
}

clipboard_state() {
    local health mode pid agent_pid error
    health="$(clipboard_status_field health || true)"
    mode="$(clipboard_status_field mode || true)"
    if [[ "$mode" == off ]]; then
        printf 'disabled by ARCH_SWAY_WSLG_CLIPBOARD=off\n'
        return 0
    fi
    if ! clipboard_running; then
        if clipboard_available; then
            printf "not running; see '%s logs'\n" "$NAME"
        else
            printf 'unavailable (bundled clipboard binaries are missing)\n'
        fi
        return 0
    fi

    pid="$(clipboard_status_field broker_pid || true)"
    agent_pid="$(clipboard_status_field agent_pid || true)"
    [[ "$pid" =~ ^[0-9]+$ ]] || pid="unknown"
    [[ "$agent_pid" =~ ^[0-9]+$ ]] || agent_pid="unknown"
    case "$health:$mode" in
        running:both)
            printf 'running (broker PID %s; Windows agent PID %s; event driven)\n' \
                "$pid" "$agent_pid"
            ;;
        running:to-windows)
            printf 'running (broker PID %s; forwarding to Windows only)\n' "$pid"
            ;;
        degraded:*)
            error="$(clipboard_status_field last_error || true)"
            printf 'degraded (broker PID %s; %s)\n' "$pid" "${error:-unknown error}"
            ;;
        starting:*)
            printf 'starting (broker PID %s)\n' "$pid"
            ;;
        *)
            printf 'running (clipboard state unavailable)\n'
            ;;
    esac
}

parse_clipboard_options() {
    case "${ARCH_SWAY_WSLG_CLIPBOARD:-both}" in
        both|to-windows|off) ;;
        *) die "invalid ARCH_SWAY_WSLG_CLIPBOARD value: ${ARCH_SWAY_WSLG_CLIPBOARD}" ;;
    esac
    case "${ARCH_SWAY_WSLG_SYNC_SENSITIVE:-0}" in
        0|1) ;;
        *) die "ARCH_SWAY_WSLG_SYNC_SENSITIVE must be 0 or 1" ;;
    esac
}

start_clipboard_service() {
    local mode="${ARCH_SWAY_WSLG_CLIPBOARD:-both}"
    parse_clipboard_options
    ensure_dirs
    mkdir -p "$CLIPBOARD_STATE_DIR"
    chmod 700 "$CLIPBOARD_STATE_DIR"

    if [[ "$mode" == off ]]; then
        {
            printf 'health=off\n'
            printf 'mode=off\n'
        } > "$CLIPBOARD_STATUS_FILE"
        return 0
    fi
    [[ -n "${WAYLAND_DISPLAY:-}" ]] || die "nested WAYLAND_DISPLAY is unavailable"
    clipboard_available || die "bundled clipboard binaries are missing"
    clipboard_running && return 0

    # The broker exits with status 3 when another start would only repeat the
    # failure (no data-control protocol, agent restart budget exhausted); the
    # start limit bounds everything else.
    user_bus_command systemd-run --user --collect --quiet \
        --unit="$CLIPBOARD_SERVICE" --service-type=exec \
        --property="BindsTo=$SESSION_SCOPE" \
        --property="After=$SESSION_SCOPE" \
        --property="Restart=on-failure" \
        --property="RestartPreventExitStatus=3" \
        --property="RestartSec=1s" \
        --property="StartLimitBurst=5" \
        --property="StartLimitIntervalSec=60s" \
        --property="TimeoutStopSec=${STOP_TIMEOUT}s" \
        --property="StandardOutput=append:$LOG_FILE" \
        --property="StandardError=append:$LOG_FILE" \
        --setenv="XDG_RUNTIME_DIR=$SYSTEMD_RUNTIME_DIR" \
        --setenv="WAYLAND_DISPLAY=$WAYLAND_DISPLAY" \
        --setenv="ARCH_SWAY_WSLG_CLIPBOARD=$mode" \
        --setenv="ARCH_SWAY_WSLG_SYNC_SENSITIVE=${ARCH_SWAY_WSLG_SYNC_SENSITIVE:-0}" \
        "$CLIPBOARD_BROKER"
}

stop_clipboard_service() {
    systemctl_user stop "$CLIPBOARD_SERVICE" >/dev/null 2>&1 || true
}

# -----------------------------------------------------------------------------
# Session lifecycle
# -----------------------------------------------------------------------------
cleanup_session_state() {
    rm -f "$SWAYSOCK_PATH"
    rm -rf -- "$X11_PRIVATE_DIR" "$CLIPBOARD_STATE_DIR"
}

# Destructive, so it must never run while the session is alive. An unreachable
# bus reports the scope as inactive, which is why every caller goes through
# ensure_dirs first: that dies when the bus cannot be reached at all.
cleanup_stale_state() {
    if ! session_scope_active; then
        stop_clipboard_service
        cleanup_session_state
    fi
}

authorize_x11_namespace() {
    note "Sudo is required only to create a private X11 mount namespace for this Sway start."
    note "Sway and all desktop applications will still run as your normal user; no global WSLg files are changed."
    sudo -v || die "sudo authorization failed; Sway was not started"
}

prepare_environment() {
    ensure_dirs
    check_wslg

    # WSLg may publish its shared runtime directory, but the managed session
    # uses systemd's owner-only per-user runtime. The parent Wayland connection
    # is an absolute path and does not depend on XDG_RUNTIME_DIR.
    export XDG_RUNTIME_DIR="$SYSTEMD_RUNTIME_DIR"
    export WAYLAND_DISPLAY="$WSLG_SOCKET"

    # A DISPLAY inherited from WSLg would send X11 clients to the outer
    # compositor. Sway reserves the nested display and exports its own value
    # while keeping XWayland itself lazy.
    unset DISPLAY

    export SWAYSOCK="$SWAYSOCK_PATH"

    export XDG_SESSION_TYPE="wayland"
    export XDG_CURRENT_DESKTOP="sway"

    # An inherited backend override can prevent nested-Wayland auto-selection,
    # and an inherited output count would outvote the one this session resolved.
    # Preserve renderer and application-specific workarounds set by the user.
    unset WLR_BACKENDS WLR_WL_OUTPUTS
    if (( SESSION_OUTPUTS > 1 )); then
        export WLR_WL_OUTPUTS="$SESSION_OUTPUTS"
    fi

    # Qt 5 never picks Wayland on its own and Qt 6 only does so when the plugin
    # is present. Keep xcb as an explicit fallback and never override a value
    # the user already set.
    : "${QT_QPA_PLATFORM:=wayland;xcb}"
    : "${QT_WAYLAND_DISABLE_WINDOWDECORATION:=1}"
    export QT_QPA_PLATFORM QT_WAYLAND_DISABLE_WINDOWDECORATION

    # VS Code's Linux launcher asks to install the Windows build when it detects
    # WSL. Inside this desktop the Linux build is the intended one.
    : "${DONT_PROMPT_WSL_INSTALL:=1}"
    export DONT_PROMPT_WSL_INSTALL

    # Java toolkits ask the window manager to reparent their windows, which
    # wlroots' XWayland does not do; without this hint Swing applications such
    # as the JetBrains IDEs render grey windows and misplaced menus.
    : "${_JAVA_AWT_WM_NONREPARENTING:=1}"
    export _JAVA_AWT_WM_NONREPARENTING

    # xdg-open reports XDG_CURRENT_DESKTOP=sway as a generic desktop and then
    # honours BROWSER first, so publishing the browser chosen at install time is
    # enough to keep links inside this session.
    if [[ -z "${BROWSER:-}" && -r "$BROWSER_FILE" ]]; then
        local browser
        IFS= read -r browser < "$BROWSER_FILE" || browser=""
        if [[ "$browser" =~ ^[A-Za-z0-9._-]+$ ]] && command -v "$browser" >/dev/null 2>&1; then
            export BROWSER="$browser"
        fi
    fi

    # This launcher is WSLg-specific, so prefer WSLg's known PulseAudio
    # endpoint even if the parent shell inherited a stale PULSE_SERVER.
    if [[ -S "$WSLG_PULSE" ]]; then
        export PULSE_SERVER="unix:$WSLG_PULSE"
    fi

    # Arch activates services such as the Secret Service through systemd, which
    # only the persistent user bus can do, so the session shares that bus rather
    # than running one of its own. Nothing is published to it in return: the
    # session's own children inherit the nested values directly.
    export DBUS_SESSION_BUS_ADDRESS="$USER_BUS_ADDRESS"
    unset DBUS_STARTER_ADDRESS DBUS_STARTER_BUS_TYPE
}

launch_session_in_namespace() {
    local target
    target="$(readlink -f -- "$X11_SOCKET_DIR")"
    [[ -d "$target" ]] || die "X11 socket directory target not found: $target"

    rm -rf -- "$X11_PRIVATE_DIR"
    mkdir -p "$X11_PRIVATE_DIR"
    chmod 1777 "$X11_PRIVATE_DIR"

    # The caller deliberately opens the user-owned log before sudo runs.
    # shellcheck disable=SC2024
    env -0 | sudo -n -- unshare --mount --propagation private -- \
        sh -c 'mount --bind "$1" "$2" && exec runuser -u "$3" -- "$4" __run_from_env' \
        _ "$X11_PRIVATE_DIR" "$target" "$USER_NAME" "$SELF" \
        9>&- >>"$LOG_FILE" 2>&1 &
    NAMESPACE_LAUNCH_PID=$!
}

run_from_environment() {
    (( EUID != 0 )) || die "internal session handoff must run as the normal user"
    local entry
    local -a environment=()

    while IFS= read -r -d '' entry; do
        environment+=("$entry")
    done
    ((${#environment[@]})) || die "session environment handoff was empty"

    # user_bus_command is a shell function and does not survive `env -i`, so the
    # same binding is repeated here. The session itself is not bounded: this is
    # the process that runs until Sway exits.
    exec env -i -- "${environment[@]}" \
        env -u DBUS_STARTER_ADDRESS -u DBUS_STARTER_BUS_TYPE \
        XDG_RUNTIME_DIR="$SYSTEMD_RUNTIME_DIR" \
        DBUS_SESSION_BUS_ADDRESS="$USER_BUS_ADDRESS" \
        systemd-run --user --scope --collect --quiet \
        --unit="$SESSION_SCOPE" --property="TimeoutStopSec=${STOP_TIMEOUT}s" \
        "$SELF" __run </dev/null
}

run_session() {
    need sway
    need Xwayland
    parse_outputs "$SESSION_OUTPUTS"
    ensure_dirs

    cleanup_session() {
        stop_clipboard_service
        cleanup_session_state
        # Queue cgroup cleanup last. The request also terminates this process,
        # so it must not block the EXIT trap.
        systemctl_user --no-block stop "$SESSION_SCOPE" >/dev/null 2>&1 || true
    }
    trap cleanup_session EXIT

    prepare_environment

    printf '\n=== Sway WSLg session: %s ===\n' "$(date --iso-8601=seconds 2>/dev/null || date)"
    printf 'Systemd scope:   %s\n' "$SESSION_SCOPE"
    printf 'Parent display:  %s\n' "$WAYLAND_DISPLAY"
    printf 'Runtime dir:     %s\n' "$XDG_RUNTIME_DIR"
    printf 'IPC socket:      %s\n' "$SWAYSOCK"
    printf 'Nested outputs:  %s\n' "$SESSION_OUTPUTS"
    printf 'X11 sockets:     private mount namespace\n'
    printf 'D-Bus:           %s\n' "$DBUS_SESSION_BUS_ADDRESS"
    sway -c "$SWAY_CONFIG"
}

wait_for_start() {
    local deadline=$((SECONDS + START_TIMEOUT)) scope_seen=0

    while (( SECONDS < deadline )); do
        ipc_ready && return 0
        if session_scope_active; then
            scope_seen=1
        elif (( scope_seen )); then
            return 1
        elif [[ "$NAMESPACE_LAUNCH_PID" =~ ^[0-9]+$ ]] && \
             ! kill -0 "$NAMESPACE_LAUNCH_PID" 2>/dev/null; then
            return 1
        fi
        sleep 0.1
    done
    return 2
}

cleanup_failed_start() {
    local deadline
    stop_clipboard_service
    systemctl_user stop "$SESSION_SCOPE" >/dev/null 2>&1 || true
    if [[ "$NAMESPACE_LAUNCH_PID" =~ ^[0-9]+$ ]] && \
       kill -0 "$NAMESPACE_LAUNCH_PID" 2>/dev/null; then
        kill -TERM "$NAMESPACE_LAUNCH_PID" 2>/dev/null || true
        deadline=$((SECONDS + STOP_TIMEOUT))
        while (( SECONDS < deadline )) && \
              kill -0 "$NAMESPACE_LAUNCH_PID" 2>/dev/null; do
            sleep 0.1
        done
        kill -KILL "$NAMESPACE_LAUNCH_PID" 2>/dev/null || true
        wait "$NAMESPACE_LAUNCH_PID" 2>/dev/null || true
    fi
    cleanup_session_state
}

# `start` and `status` describe the same running session, so both report it the
# same way. Only reached with the session scope active.
report_running_session() {
    note "Systemd scope: active ($SESSION_SCOPE)"
    note "D-Bus: $USER_BUS_ADDRESS (shared user bus)"
    if ipc_ready; then
        note "IPC: ready ($SWAYSOCK_PATH)"
    else
        note "IPC: not ready ($SWAYSOCK_PATH)"
    fi
    note "XWayland: configured (lazy; see logs for runtime errors)"
    note "Clipboard: $(clipboard_state)"
    note "Log: $LOG_FILE"
}

start_session() {
    parse_session_options "$@"
    session_requirements
    ensure_dirs
    take_control_lock

    cleanup_stale_state

    if session_scope_active; then
        ipc_ready || \
            die "Sway systemd scope is active but IPC is not ready; use '$NAME status', '$NAME logs', or '$NAME stop'"
        note "Sway is already running."
        report_running_session
        return 0
    fi

    [[ -r "$SWAY_CONFIG" ]] || die "Sway config not readable: $SWAY_CONFIG"
    check_wslg
    authorize_x11_namespace
    rm -f "$SWAYSOCK_PATH"
    : > "$LOG_FILE"

    note "Starting Sway in background..."
    export ARCH_SWAY_WSLG_OUTPUTS="$SESSION_OUTPUTS"
    launch_session_in_namespace

    local rc
    set +e
    wait_for_start
    rc=$?
    set -e

    case "$rc" in
        0)
            note "Sway started successfully."
            report_running_session
            ;;
        1)
            cleanup_failed_start
            printf '\nSway failed to start. Last log lines:\n\n' >&2
            tail -n 40 "$LOG_FILE" >&2 || true
            return 1
            ;;
        2)
            cleanup_failed_start
            warn "Sway IPC did not become ready within ${START_TIMEOUT}s."
            note "Check: $NAME status"
            note "Logs:  $NAME logs"
            return 1
            ;;
    esac
}

# Sway IPC is the graceful path; without it the session scope is stopped
# directly, so a missing swaymsg must not keep the session running.
stop_session() {
    ensure_dirs
    take_control_lock

    cleanup_stale_state

    if ! session_scope_active; then
        note "Sway is not running."
        return 0
    fi

    local deadline
    note "Stopping Sway..."

    if ipc_ready; then
        swaymsg -s "$SWAYSOCK_PATH" exit >/dev/null 2>&1 || true

        deadline=$((SECONDS + STOP_TIMEOUT))
        while (( SECONDS < deadline )); do
            if ! session_scope_active; then
                stop_clipboard_service
                cleanup_session_state
                note "Sway stopped."
                return 0
            fi
            sleep 0.1
        done
    fi

    warn "Sway did not exit cleanly; stopping its systemd scope."
    systemctl_user stop "$SESSION_SCOPE" >/dev/null 2>&1 || true
    if session_scope_active; then
        die "systemd scope is still active after its stop timeout: $SESSION_SCOPE"
    fi
    stop_clipboard_service
    cleanup_session_state
    note "Sway stopped."
}

# Observation only. Removing stale state here would race a start that has not
# entered its scope yet, and the installer calls this while holding the control
# lock, so it must neither take that lock nor change anything.
status_session() {
    systemd_user_usable || \
        die "systemd user runtime is unavailable: $SYSTEMD_RUNTIME_DIR"

    if ! session_scope_active; then
        note "Sway: stopped"
        return 1
    fi

    note "Sway: running"
    report_running_session
}

restart_session() {
    parse_session_options "$@"
    session_requirements
    stop_session
    start_session --outputs "$SESSION_OUTPUTS"
}

# A session that refuses to start is exactly when the log has to be readable,
# so this command depends on nothing but the file itself.
show_logs() {
    [[ -r "$LOG_FILE" ]] || die "no session log yet: $LOG_FILE"
    exec tail -F "$LOG_FILE"
}

doctor() {
    local failed=0 cmd path_launcher bus_names=""
    parse_outputs "$SESSION_OUTPUTS"
    note "Sway WSLg launcher diagnostics"
    note "-----------------------------"

    if systemd_user_usable; then
        note "OK   systemd user manager"
        note "OK   systemd user runtime: $SYSTEMD_RUNTIME_DIR"
    else
        note "FAIL systemd user manager or runtime is unavailable"
        failed=1
    fi

    # The session shares this bus with the rest of the WSL user, so the two
    # names that decide whether credentials and notifications work inside it are
    # reported here instead of only in the session log.
    if bus_names="$(user_bus_command busctl --user list --no-pager --no-legend 2>/dev/null)"; then
        note "OK   session bus: $USER_BUS_ADDRESS"

        case "$(bus_name_state "$bus_names" org.freedesktop.secrets || true)" in
            owned)
                note "OK   Secret Service: org.freedesktop.secrets is running"
                ;;
            activatable)
                note "OK   Secret Service: org.freedesktop.secrets can be activated"
                ;;
            *)
                note "INFO no Secret Service on the bus; install oo7 for Seahorse, browsers and IDEs"
                ;;
        esac

        # The bus is shared, so the listing cannot say which process owns a
        # name. Report the state and leave the conclusion to the reader.
        case "$(bus_name_state "$bus_names" org.freedesktop.Notifications || true)" in
            owned)
                note "INFO notifications: org.freedesktop.Notifications is already owned on this bus"
                ;;
            activatable)
                note "INFO notifications: org.freedesktop.Notifications is activatable on this bus"
                ;;
            *)
                note "OK   notifications: org.freedesktop.Notifications is free for SwayNC"
                ;;
        esac

        case "$(bus_name_state "$bus_names" org.freedesktop.portal.Desktop || true)" in
            owned)
                note "OK   desktop portal is running"
                ;;
            activatable)
                note "OK   desktop portal can be activated"
                ;;
            *)
                note "FAIL desktop portal is unavailable"
                failed=1
                ;;
        esac

        case "$(bus_name_state "$bus_names" org.freedesktop.impl.portal.desktop.gtk || true)" in
            owned)
                note "OK   GTK portal backend is running"
                ;;
            activatable)
                note "OK   GTK portal backend can be activated"
                ;;
            *)
                note "FAIL GTK portal backend is unavailable"
                failed=1
                ;;
        esac
    else
        note "FAIL session bus is not reachable: $USER_BUS_ADDRESS"
        failed=1
    fi

    path_launcher="$(command -v "$NAME" 2>/dev/null || true)"
    if [[ -n "$path_launcher" ]] && \
       [[ "$(readlink -f "$path_launcher")" == "$SELF" ]]; then
        note "OK   launcher in PATH: $path_launcher"
    elif [[ -n "$path_launcher" ]]; then
        note "FAIL PATH resolves $NAME to a different file: $path_launcher"
        failed=1
    else
        note "FAIL launcher not found in PATH: $NAME"
        failed=1
    fi

    for cmd in "${SESSION_COMMANDS[@]}" "${SESSION_APPLICATIONS[@]}"; do
        if command -v "$cmd" >/dev/null 2>&1; then
            note "OK   command: $cmd"
        else
            note "FAIL command: $cmd"
            failed=1
        fi
    done

    for cmd in "${SESSION_MEDIA_COMMANDS[@]}"; do
        if command -v "$cmd" >/dev/null 2>&1; then
            note "OK   command: $cmd"
        else
            note "INFO command: $cmd is missing; its media keys do nothing"
        fi
    done

    if [[ -x "$CLIPBOARD_BROKER" ]]; then
        note "OK   clipboard broker: $CLIPBOARD_BROKER"
        if timeout 5s "$CLIPBOARD_BROKER" --probe >/dev/null 2>&1; then
            note "OK   clipboard broker probe"
        else
            note "FAIL clipboard broker probe failed"
            failed=1
        fi
    else
        note "FAIL clipboard broker is missing or not executable: $CLIPBOARD_BROKER"
        failed=1
    fi
    if [[ -x "$CLIPBOARD_AGENT" ]]; then
        if timeout 5s "$CLIPBOARD_AGENT" --probe >/dev/null 2>&1; then
            note "OK   Windows clipboard agent: $CLIPBOARD_AGENT"
        else
            note "FAIL Windows clipboard agent cannot run through WSL interop: $CLIPBOARD_AGENT"
            failed=1
        fi
    else
        note "FAIL Windows clipboard agent is missing or not executable: $CLIPBOARD_AGENT"
        failed=1
    fi

    if grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null; then
        note "OK   WSL kernel"
    else
        note "FAIL WSL kernel not detected"
        failed=1
    fi

    if [[ -S "$WSLG_SOCKET" ]]; then
        note "OK   WSLg socket: $WSLG_SOCKET"
    else
        note "FAIL WSLg socket: $WSLG_SOCKET"
        failed=1
    fi

    if [[ -d "$X11_SOCKET_DIR" ]]; then
        note "OK   X11 socket directory: $X11_SOCKET_DIR"
    else
        note "FAIL X11 socket directory: $X11_SOCKET_DIR"
        failed=1
    fi

    if [[ -r "$SWAY_CONFIG" ]]; then
        note "OK   Sway config file: $SWAY_CONFIG"
    else
        note "FAIL Sway config file: $SWAY_CONFIG"
        failed=1
    fi

    if [[ -S "$WSLG_PULSE" ]]; then
        note "OK   WSLg Pulse socket: $WSLG_PULSE"
        if command -v pactl >/dev/null 2>&1 && \
           timeout 2s env PULSE_SERVER="unix:$WSLG_PULSE" pactl info >/dev/null 2>&1; then
            note "OK   WSLg PulseAudio connection"
        else
            note "INFO WSLg PulseAudio connection failed"
        fi
    else
        note "INFO WSLg Pulse socket not detected: $WSLG_PULSE"
    fi

    note "INFO WSLg parent display: $WSLG_SOCKET"
    note "INFO runtime:             $RUNTIME_DIR"
    note "INFO IPC:                 $SWAYSOCK_PATH"
    note "INFO nested outputs:      $SESSION_OUTPUTS (override with --outputs)"
    return "$failed"
}

usage() {
    cat <<EOF2
Usage: $NAME <command> [options]

Commands:
  start [--outputs N]    Start the managed Sway session (N nested outputs, 1-$OUTPUTS_MAX)
  stop                   Stop the managed Sway session
  restart [--outputs N]  Restart the managed Sway session
  status                 Report session, bus, IPC and clipboard state
  logs                   Follow the session log
  doctor                 Check runtime prerequisites
  version                Print the launcher version
EOF2
}

(( EUID != 0 )) || die "run this launcher as your normal Arch user, not as root"

COMMAND="${1:-start}"
if (( $# )); then
    shift
fi

case "$COMMAND" in
    start) start_session "$@" ;;
    stop) stop_session ;;
    restart) restart_session "$@" ;;
    status) status_session ;;
    logs|log) show_logs ;;
    doctor) doctor ;;
    __run) run_session ;;
    __run_from_env) run_from_environment ;;
    __start_clipboard) start_clipboard_service ;;
    --version|version) printf '%s %s\n' "$NAME" "$VERSION" ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
esac
